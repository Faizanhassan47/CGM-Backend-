# =========================================================
# CGM PATIENT APPLICATION & BACKEND ENVIRONMENT CONFIGURATION
# =========================================================

# Database Configuration (Microsoft SQL Server)
DB_SERVER=your_sql_server
DB_NAME=your_database_name
DB_TRUSTED_CONNECTION=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=true

# Connection String
DB_CONNECTION_STRING="Server=your_sql_server;Database=your_database_name;Trusted_Connection=True;TrustServerCertificate=False;Encrypt=True;"

# JWT Authentication
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_ISSUER=CGM.Api
JWT_AUDIENCE=CGM.PatientApp
JWT_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=30

# API Server Host
API_PORT=5000
API_HTTPS_PORT=5001
ASPNETCORE_ENVIRONMENT=Development

# Patient app runtime mode. Keep false for real API authentication.
CGM_USE_MOCK_SERVICES=false
CGM_API_BASE_URL=http://localhost:5232/
CORS_ALLOWED_ORIGINS=https://your-web-client.example.com

# =========================================================
# SMTP EMAIL CONFIGURATION
# =========================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME="GlucoTrack CGM Platform"
APP_RESET_URL="https://example.com/reset-password"
POP_HOST=pop.example.com
POP_PORT=995
POP_SSL=true
